@model List<SanPham>
@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="row">
    <div class="col-md-3">
        <div class="card">
            <div class="card-header">
                <h5>Danh mục sản phẩm</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li><a href="@Url.Action("Index")" class="@(ViewBag.DanhMucId == null ? "fw-bold" : "")">Tất cả</a></li>
                    @foreach (var dm in ViewBag.DanhMucs as List<DanhMuc>)
                    {
                        <li class="mt-2">
                            <a href="@Url.Action("Index", new { danhMucId = dm.IddanhMuc })"
                               class="@(ViewBag.DanhMucId == dm.IddanhMuc ? "fw-bold" : "")">
                                @dm.TenDanhMuc
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-md-9">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card h-100">
                        <img src="~/images/@item.AnhSanPham" class="card-img-top" alt="@item.TenSanPham"
                             style="height: 200px; object-fit: cover;"
                             onerror="this.src='~/images/default-food.jpg'">

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.TenSanPham</h5>
                            <p class="card-text">@item.MoTaSanPham</p>
                            <p class="card-text"><small class="text-muted">@item.IddanhMucNavigation?.TenDanhMuc</small></p>
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="h5 text-danger">@item.GiaSanPham.ToString("N0") VNĐ</span>
                                    <div class="btn-group">
                                        <a href="@Url.Action("Details", new { id = item.IdsanPham })"
                                           class="btn btn-outline-primary btn-sm">Chi tiết</a>

                                        <form asp-controller="SanPham" asp-action="ThemGioHang" method="post" class="d-inline">
                                            <input type="hidden" name="sanPhamId" value="@item.IdsanPham" />
                                            <input type="hidden" name="soLuong" value="1" />
                                            <button type="submit" class="btn btn-primary btn-sm">
                                                <i class="fas fa-cart-plus"></i> Thêm giỏ
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Phân trang -->
        @if (ViewBag.TotalPages > 1)
        {
            <nav aria-label="Product pagination">
                <ul class="pagination justify-content-center">
                    <!-- Previous -->
                    @if (ViewBag.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, danhMucId = ViewBag.DanhMucId })">
                                &laquo; Trước
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">&laquo; Trước</span>
                        </li>
                    }

                    <!-- Page numbers -->
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" href="@Url.Action("Index", new { page = i, danhMucId = ViewBag.DanhMucId })">
                                @i
                            </a>
                        </li>
                    }

                    <!-- Next -->
                    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, danhMucId = ViewBag.DanhMucId })">
                                Sau &raquo;
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">
                            <span class="page-link">Sau &raquo;</span>
                        </li>
                    }
                </ul>
            </nav>
        }

        <div class="text-center mt-3">
            <small class="text-muted">
                Hiển thị @((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1) -
                @(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalItems))
                trong tổng số @ViewBag.TotalItems sản phẩm
            </small>
        </div>
    </div>
</div>